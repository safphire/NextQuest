<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup (SPEC.md §9.4): DB + DataStore restore on reinstall or
    a new device. The AI key prefs (M4, Keystore-encrypted, device-bound) are
    excluded up front — they'd restore as garbage.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ai_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
