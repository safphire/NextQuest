<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup: the event log (database) and settings restore on
    reinstall or a new device. The sync device token is excluded — it is a
    credential bound to this install; the user re-pairs instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sync_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sync_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
