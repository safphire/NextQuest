                                        "text": {
                                            "type": "string"
                                        },
                                        "due_at": {
                                            "type": [
                                                "string",
                                                "null"
                                            ]
                                        },
                                        "alarm": {
                                            "type": "boolean"
                                        },
                                        "done": {
                                            "type": "boolean"
