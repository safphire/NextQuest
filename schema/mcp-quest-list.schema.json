                    },
                    "subquests_done": {
                        "type": "integer"
                    },
                    "subquests_total": {
                        "type": "integer"
                    },
                    "subquests": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "title": {
                                    "type": "string"
                                },
                                "status": {
                                    "type": "string"
                                },
                                "focused": {
                                    "type": "boolean"
                                },
                                "next_step": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "properties": {
                                        "id": {
