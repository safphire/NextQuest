                                "id",
                                "title",
                                "status",
                                "focused"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "created_at": {
                        "type": "string"
                    },
                    "touched_at": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "title",
                    "status",
                    "created_at",
                    "touched_at"
                ],
                "additionalProperties": false
            }
