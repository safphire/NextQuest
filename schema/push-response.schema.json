{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "push-response",
    "type": "object",
    "properties": {
        "accepted": {
            "type": "integer"
        },
        "duplicates": {
            "type": "integer"
        },
        "rejected": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "reason"
                ],
                "additionalProperties": false
            }
        },
        "cursor": {
            "type": "integer"
        }
    },
    "required": [
        "accepted",
        "duplicates",
        "cursor"
    ],
    "additionalProperties": false
}
