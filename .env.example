# Copy to .env and fill in. Never commit .env.
# Admin password for the server page and for approving AI connectors (12+ characters).
ADMIN_PASSWORD=
# The public HTTPS URL of this server (what the app and Claude/ChatGPT will use).
PUBLIC_URL=https://quests.example.com
# Display name (rename-ready: the only place the product name lives on the server).
APP_NAME=NextQuest
# Time zone for "today" in AI answers.
TZ=Europe/Berlin
# Host port, and the host address compose publishes it on: 127.0.0.1 = only this machine
# (a reverse proxy here); 0.0.0.0 = the whole LAN. Inside the container the server always
# listens on 0.0.0.0:8080; these two only affect the published port.
PORT=8080
BIND_ADDRESS=127.0.0.1
# Reverse proxies in front of the server (hops). 1 is right behind a reverse proxy on the
# same host; X-Forwarded-For is only honoured from loopback/private/Docker addresses.
# Set 0 if clients connect directly; never set it higher than the actual number of hops.
TRUST_PROXY=1
# Browser origins allowed to call /mcp, comma-separated. Empty = Claude and ChatGPT
# (https://claude.ai,https://chatgpt.com). Non-browser clients send no Origin and aren't affected.
ALLOWED_ORIGINS=
