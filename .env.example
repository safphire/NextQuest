# Copy to .env and fill in. Never commit .env.
# Admin password for the server page and for approving AI connectors (12+ characters).
ADMIN_PASSWORD=
# The public HTTPS URL of this server (what the app and Claude/ChatGPT will use).
PUBLIC_URL=https://quests.example.com
# Display name (rename-ready: the only place the product name lives on the server).
APP_NAME=NextQuest
# Time zone for "today" in AI answers.
TZ=Europe/Berlin
# Host port, and the address it is published on: 127.0.0.1 = only this machine (a reverse
# proxy here); 0.0.0.0 = the whole LAN.
PORT=8080
BIND_ADDRESS=127.0.0.1
# Reverse proxies in front of the server (hops). 0 = none. With a proxy, rate limits only
# see real client IPs when this is set; never set it higher than the actual number of hops.
TRUST_PROXY=0
